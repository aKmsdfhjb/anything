# Copy to .env.local for local development. Never commit real credentials.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Android map rendering. Restrict this Google Maps key to the Android app/package and signing certificate.
GOOGLE_MAPS_API_KEY=YOUR_RESTRICTED_GOOGLE_MAPS_API_KEY

# Optional destination geocoding. Use a public token restricted to this app/domain.
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=YOUR_RESTRICTED_MAPBOX_PUBLIC_TOKEN

# Server-only secret. Do not use in client/mobile/web bundles.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
